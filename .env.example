# Copy to a private .env (chmod 600). Never commit configured credentials.
# Contract: docs/architecture/deployment.md. Initial example configuration.
# ./scripts/setup.sh (to be implemented) generates missing local secrets and
# internal DB credentials; production startup rejects unreplaced placeholders.
APP_ENV=development
DEPLOYMENT_MODE=self-hosted
DATABASE_MODE=local
# Supply first-run values here or answer setup's prompts. No customer defaults.
SETUP_ORGANISATION_NAME=
SETUP_ORGANISATION_SLUG=
SETUP_OWNER_EMAIL=
APP_VERSION=0.0.1-prebuild
# Disable framework telemetry for builds and runtime.
NEXT_TELEMETRY_DISABLED=1
APP_IMAGE=trusts-crm:local
OPERATOR_IMAGE=trusts-crm:local-operator
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Production requires HTTPS. Choose any available host/listener ports.
APP_BIND=127.0.0.1
APP_PORT=3000
INTERNAL_PORT=3000

# Setup starts bundled PostgreSQL when DATABASE_MODE=local.
# For external PostgreSQL set DATABASE_MODE=external and supply the operator
# connection below; require remote DB TLS and provisioning authority.
# Advanced/internal settings: ordinary local setup fills missing credentials.
POSTGRES_DB=trusts_control
POSTGRES_USER=trusts_provisioner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_BOOTSTRAP_PASSWORD
# Passwords with reserved URL characters must be percent-encoded.
# Setup generates/validates restricted roles and their connections internally.
# Existing credentials must be preserved on retry, never regenerated silently.
CONTROL_DATABASE_URL=postgresql://trusts_control_app:REPLACE_WITH_RANDOM_CONTROL_PASSWORD@postgres:5432/trusts_control
CONTROL_MIGRATION_DATABASE_URL=postgresql://trusts_control_migrator:REPLACE_WITH_RANDOM_MIGRATION_PASSWORD@postgres:5432/trusts_control
PROVISION_DATABASE_URL=postgresql://trusts_provisioner:REPLACE_WITH_RANDOM_BOOTSTRAP_PASSWORD@postgres:5432/postgres
# Internal paths are configurable container mounts, not development-host paths.
TENANT_CREDENTIALS_DIR=/run/trusts/tenants

# Setup generates >=32 random bytes if missing; never use this placeholder.
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Local synthetic mail capture: --profile dev-mail. Production requires a
# TLS relay: SMTP_SECURE=true for implicit TLS, otherwise require STARTTLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Trusts CRM <noreply@trusts-crm.invalid>
MAILPIT_UI_PORT=8025

# local is implemented first; S3-compatible adapter is a later option.
STORAGE_BACKEND=local
STORAGE_ROOT=/var/lib/trusts-crm/attachments
MAX_UPLOAD_BYTES=20971520
MAX_IMPORT_BYTES=5242880
# Upload security is mandatory; scanner integration is deployment-dependent.
# Optional adapter/provider settings are documented separately when implemented.

DEFAULT_TIMEZONE=Europe/London
DEFAULT_LOCALE=en-GB
LOG_LEVEL=info
# Empty trusts no forwarded client-IP headers. Set exact proxy CIDRs only.
TRUSTED_PROXY_CIDRS=
# Required by synthetic seed, never overrides production refusal.
SYNTHETIC_DATA_ACK=synthetic-only
