{
  "name": "trusts-crm",
  "version": "0.0.1-prebuild",
  "private": true,
  "description": "Portable trusts and foundations fundraising CRM; pre-build bootstrap",
  "packageManager": "pnpm@10.18.3",
  "engines": { "node": ">=24 <25", "pnpm": ">=10 <11" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "setup": "tsx scripts/setup.ts",
    "setup:database": "tsx scripts/setup-database.ts",
    "db:generate": "prisma generate --schema prisma/control/schema.prisma && prisma generate --schema prisma/tenant/schema.prisma",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "tenant:create": "tsx scripts/create-tenant.ts",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "tenant:export": "tsx scripts/export-tenant.ts",
    "tenant:restore": "tsx scripts/restore-tenant.ts"
  },
  "dependencies": {
    "@fullcalendar/core": "~6.1.19",
    "@fullcalendar/daygrid": "~6.1.19",
    "@fullcalendar/multimonth": "~6.1.19",
    "@fullcalendar/react": "~6.1.19",
    "@prisma/client": "~6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "better-auth": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^27.0.0",
    "prisma": "~6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
